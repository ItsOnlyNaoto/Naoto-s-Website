<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Castorice | Login</title>

    <style>
        /* =========================
           GENERAL SETTINGS
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            color: white;
            background: #100c20;
        }

        /* =========================
           TEMPORARY BACKGROUND
           Replace this later with
           your Castorice video.
        ========================= */

        .background {
            position: fixed;
            inset: 0;
            z-index: -2;

            background:
                radial-gradient(
                    circle at 20% 30%,
                    rgba(159, 91, 255, 0.45),
                    transparent 40%
                ),
                radial-gradient(
                    circle at 80% 70%,
                    rgba(91, 69, 180, 0.4),
                    transparent 40%
                ),
                linear-gradient(
                    135deg,
                    #100c20,
                    #251440,
                    #130d29,
                    #302052
                );

            background-size: 200% 200%;
            animation: backgroundMove 12s ease infinite;
        }

        @keyframes backgroundMove {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        /* =========================
           BACKGROUND OVERLAY
        ========================= */

        .overlay {
            position: fixed;
            inset: 0;
            z-index: -1;

            background: rgba(8, 5, 18, 0.35);
        }

        /* =========================
           DECORATIVE GLOW
        ========================= */

        .glow {
            position: fixed;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: rgba(175, 123, 255, 0.15);
            filter: blur(100px);
            pointer-events: none;
            animation: floatingGlow 8s ease-in-out infinite alternate;
        }

        .glow.one {
            top: -100px;
            left: -100px;
        }

        .glow.two {
            bottom: -120px;
            right: -100px;
            animation-delay: 2s;
        }

        @keyframes floatingGlow {
            from {
                transform: translate(0, 0);
            }

            to {
                transform: translate(50px, 30px);
            }
        }

        /* =========================
           FLOATING PARTICLES
        ========================= */

        .particles {
            position: fixed;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: -1;
        }

        .particle {
            position: absolute;
            bottom: -20px;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #e8d8ff;
            box-shadow: 0 0 12px #c9a4ff;

            animation: floatUp linear infinite;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(0) translateX(0);
                opacity: 0;
            }

            15% {
                opacity: 0.8;
            }

            85% {
                opacity: 0.7;
            }

            100% {
                transform: translateY(-110vh) translateX(40px);
                opacity: 0;
            }
        }

        /* =========================
           MAIN LOGIN CONTAINER
        ========================= */

        .login-container {
            width: 400px;
            max-width: calc(100% - 36px);
            padding: 42px 35px;

            background: rgba(25, 17, 44, 0.48);
            border: 1px solid rgba(222, 203, 255, 0.24);
            border-radius: 24px;

            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);

            box-shadow:
                0 0 50px rgba(144, 87, 255, 0.12),
                0 20px 60px rgba(0, 0, 0, 0.3),
                inset 0 0 25px rgba(255, 255, 255, 0.025);

            text-align: center;

            animation: cardAppear 1s ease;
        }

        @keyframes cardAppear {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =========================
           LOGO / DECORATION
        ========================= */

        .logo {
            width: 76px;
            height: 76px;
            margin: 0 auto 20px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 50%;
            border: 1px solid rgba(226, 207, 255, 0.6);

            background: linear-gradient(
                135deg,
                rgba(206, 172, 255, 0.25),
                rgba(102, 65, 160, 0.12)
            );

            box-shadow:
                0 0 25px rgba(180, 129, 255, 0.2),
                inset 0 0 20px rgba(255, 255, 255, 0.06);

            font-size: 35px;
            color: #eadcff;
        }

        /* =========================
           HEADINGS
        ========================= */

        .welcome {
            font-size: 13px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #cbb2f4;
            margin-bottom: 8px;
        }

        h1 {
            font-size: 32px;
            font-weight: 500;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .subtitle {
            font-size: 13px;
            color: #c4b8d8;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        /* =========================
           INPUT FIELDS
        ========================= */

        .input-group {
            text-align: left;
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            margin-bottom: 9px;
            font-size: 12px;
            letter-spacing: 1px;
            color: #dfd0f7;
        }

        .input-box {
            position: relative;
        }

        .input-box input {
            width: 100%;
            padding: 15px 45px 15px 15px;

            color: white;
            font-size: 14px;

            background: rgba(255, 255, 255, 0.055);
            border: 1px solid rgba(215, 192, 255, 0.2);
            border-radius: 10px;

            outline: none;
            transition: 0.3s;
        }

        .input-box input::placeholder {
            color: #a99abf;
        }

        .input-box input:focus {
            border-color: #bd91ff;
            background: rgba(255, 255, 255, 0.09);

            box-shadow:
                0 0 15px rgba(176, 121, 255, 0.12);
        }

        .input-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #c7a9f5;
            font-size: 17px;
        }

        /* =========================
           REMEMBER / FORGOT
        ========================= */

        .options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;

            font-size: 12px;
            margin: 5px 0 25px;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #c9bddb;
        }

        .remember input {
            accent-color: #b58aff;
        }

        a {
            color: #d0b2ff;
            text-decoration: none;
            transition: 0.3s;
        }

        a:hover {
            color: white;
            text-shadow: 0 0 10px #c7a0ff;
        }

        /* =========================
           LOGIN BUTTON
        ========================= */

        .login-button {
            width: 100%;
            padding: 15px;

            border: none;
            border-radius: 10px;

            color: #211334;
            font-size: 13px;
            font-weight: bold;
            letter-spacing: 3px;
            text-transform: uppercase;

            cursor: pointer;

            background: linear-gradient(
                100deg,
                #d7baff,
                #a77bf2,
                #d7baff
            );

            background-size: 200% 100%;

            box-shadow:
                0 5px 25px rgba(160, 104, 255, 0.2);

            transition: 0.3s;
        }

        .login-button:hover {
            background-position: 100% 0;
            transform: translateY(-2px);

            box-shadow:
                0 8px 30px rgba(176, 121, 255, 0.35);
        }

        .login-button:active {
            transform: scale(0.98);
        }

        /* =========================
           DIVIDER
        ========================= */

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;

            margin: 25px 0;

            color: #9f90b4;
            font-size: 11px;
            letter-spacing: 2px;
        }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: rgba(220, 199, 255, 0.18);
        }

        /* =========================
           GUEST BUTTON
        ========================= */

        .guest-button {
            display: block;
            width: 100%;
            padding: 13px;

            border: 1px solid rgba(218, 197, 255, 0.3);
            border-radius: 10px;

            color: #e0d1f7;
            background: rgba(255, 255, 255, 0.035);

            font-size: 12px;
            letter-spacing: 1px;

            cursor: pointer;
            transition: 0.3s;
        }

        .guest-button:hover {
            background: rgba(189, 145, 255, 0.12);
            border-color: #bd91ff;
        }

        /* =========================
           FOOTER
        ========================= */

        .footer {
            margin-top: 28px;
            color: #a99bbd;
            font-size: 11px;
            letter-spacing: 0.5px;
        }

        .footer span {
            color: #d4b7ff;
        }

        /* =========================
           MOBILE RESPONSIVENESS
        ========================= */

        @media (max-width: 450px) {
            .login-container {
                padding: 35px 24px;
            }

            h1 {
                font-size: 28px;
            }

            .logo {
                width: 65px;
                height: 65px;
                font-size: 30px;
            }

            .options {
                font-size: 11px;
            }
        }

        @media (max-height: 650px) {
            body {
                overflow-y: auto;
                padding: 20px 0;
            }

            .login-container {
                padding-top: 25px;
                padding-bottom: 25px;
            }

            .logo {
                width: 55px;
                height: 55px;
                margin-bottom: 12px;
                font-size: 27px;
            }

            .subtitle {
                margin-bottom: 20px;
            }
        }

    </style>
</head>

<body>

    <!-- TEMPORARY BACKGROUND -->
    <div class="background"></div>
    <div class="overlay"></div>

    <!-- PURPLE GLOW EFFECTS -->
    <div class="glow one"></div>
    <div class="glow two"></div>

    <!-- FLOATING PARTICLES -->
    <div class="particles" id="particles"></div>

    <!-- LOGIN CARD -->
    <main class="login-container">

        <div class="logo">✧</div>

        <p class="welcome">Welcome Back</p>

        <h1>Enter the Unknown</h1>

        <p class="subtitle">
            A quiet place beyond the stars.<br>
            Your journey begins here.
        </p>

        <!-- LOGIN FORM -->
        <form id="loginForm">

            <div class="input-group">

                <label for="username">USERNAME</label>

                <div class="input-box">

                    <input
                        type="text"
                        id="username"
                        name="username"
                        placeholder="Enter your username"
                        autocomplete="username"
                        required
                    >

                    <span class="input-icon">♙</span>

                </div>

            </div>

            <div class="input-group">

                <label for="password">PASSWORD</label>

                <div class="input-box">

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >

                    <span
                        class="input-icon"
                        id="togglePassword"
                        role="button"
                        tabindex="0"
                        aria-label="Show password"
                        style="cursor: pointer;"
                    >◉</span>

                </div>

            </div>

            <div class="options">

                <label class="remember">
                    <input type="checkbox" id="remember">
                    Remember me
                </label>

                <a href="#" id="forgotPassword">
                    Forgot password?
                </a>

            </div>

            <button type="submit" class="login-button">
                Sign In
            </button>

        </form>

        <div class="divider">OR</div>

        <button
            type="button"
            class="guest-button"
            id="guestButton"
        >
            Continue as Guest ↗
        </button>

        <p class="footer">
            Made with <span>✧</span> and a little bit of magic
        </p>

    </main>

    <script>

        // =========================
        // CREATE FLOATING PARTICLES
        // =========================

        const particlesContainer =
            document.getElementById("particles");

        for (let i = 0; i < 35; i++) {

            const particle = document.createElement("div");

            particle.classList.add("particle");

            particle.style.left = Math.random() * 100 + "%";

            particle.style.animationDuration =
                (6 + Math.random() * 10) + "s";

            particle.style.animationDelay =
                (Math.random() * 10) + "s";

            const size = (2 + Math.random() * 3) + "px";

            particle.style.width = size;
            particle.style.height = size;

            particlesContainer.appendChild(particle);

        }


        // =========================
        // SHOW / HIDE PASSWORD
        // =========================

        const passwordInput =
            document.getElementById("password");

        const togglePassword =
            document.getElementById("togglePassword");

        function changePasswordVisibility() {

            if (passwordInput.type === "password") {

                passwordInput.type = "text";

                togglePassword.textContent = "◎";

                togglePassword.setAttribute(
                    "aria-label",
                    "Hide password"
                );

            } else {

                passwordInput.type = "password";

                togglePassword.textContent = "◉";

                togglePassword.setAttribute(
                    "aria-label",
                    "Show password"
                );

            }

        }

        togglePassword.addEventListener(
            "click",
            changePasswordVisibility
        );

        togglePassword.addEventListener("keydown", function(event) {

            if (event.key === "Enter" || event.key === " ") {

                event.preventDefault();

                changePasswordVisibility();

            }

        });


        // =========================
        // LOGIN FORM
        // TEMPORARY DEMONSTRATION
        // =========================

        document.getElementById("loginForm")
            .addEventListener("submit", function(event) {

                event.preventDefault();

                const username =
                    document.getElementById("username").value.trim();

                if (username !== "") {

                    alert(
                        "Welcome, " + username +
                        "!\n\nYour login design is working. " +
                        "Real account verification will be added later."
                    );

                }

            });


        // =========================
        // FORGOT PASSWORD
        // =========================

        document.getElementById("forgotPassword")
            .addEventListener("click", function(event) {

                event.preventDefault();

                alert(
                    "Password recovery will be added later."
                );

            });


        // =========================
        // GUEST BUTTON
        // =========================

        document.getElementById("guestButton")
            .addEventListener("click", function() {

                alert(
                    "Welcome, Guest!\n\n" +
                    "The destination page will be added later."
                );

            });

    </script>

</body>
</html>
